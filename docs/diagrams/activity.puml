@startuml activity
' ============================================================
' Activity Diagram — CLI Attack Command Execution
' tsunami attack --url <URL> --rate 100/1s --workers 50 ...
' ============================================================

skinparam activityFontSize 13
skinparam activityArrowThickness 1.5
skinparam swimlaneBorderThickness 2
skinparam noteBackgroundColor #FFFFCC

|CLI|
start

:Parse cobra flags\n(url, rate, duration, timeout,\nworkers, connections, method, headers, body, output);

:attackPreRun validation;

if (URL valid?) then (no)
  :Print error & exit;
  stop
endif

if (Rate format valid?) then (no)
  :Print error & exit;
  stop
endif

if (Workers & Connections\nwithin limits?) then (no)
  :Print error & exit;
  stop
endif

:ParseRateToRPS(rate) → RPS;
:Build AttackConfig;
:Create GlobalMetrics;
:Setup SIGINT signal handler;
:Start liveProgress() goroutine\n(ANSI progress bar, updates every 100 ms);

|AttackRunner|

:createHTTPClient(cfg)\n(connection pool, timeout, keep-alive);
:Create jobs channel (buffered)\nCreate results channel (buffered);
:Initialize go.uber.org/ratelimit\n(RPS tokens per second);

fork
    |Worker (×N)|
    repeat
        :Wait for job token\nfrom jobs channel;
        :Build http.Request\n(method, URL, body, headers);
        :client.Do(req)\n(execute HTTP request);
        :Read response body\n(measure latency);
        :Build RequestResult\n(StatusCode, Latency, Success,\nByteSent, BytesReceived, ErrorType);
        :Send RequestResult\nto results channel;
    repeat while (jobs channel open?) is (yes)
    ->no;
    :Worker exits;

fork again
    |MetricsCollector|
    repeat
        :Receive RequestResult\nfrom results channel;
        :Lock GlobalMetrics;
        :TotalRequests++;
        if (result.Success?) then (yes)
            :Successes++;
        else (no)
            :Failures++;
            :ErrorTypes[errType]++;
        endif
        :AddLatency(result.Latency)\n(update min/max, circular buffers,\nlatencyHistory sample);
        :StatusCodes[code]++;
        :AddBytes(sent, received);
        :Unlock GlobalMetrics;
    repeat while (results channel open?) is (yes)
    ->no;
    :Collector exits;

fork again
    |AttackRunner|
    :Start rate-limited job dispatcher;
    repeat
        :ratelimiter.Take()\n(block until next allowed token);
        if (stopCh closed?) then (yes)
            break
        endif
        if (duration > 0 AND elapsed >= duration?) then (yes)
            :close(stopCh);
            break
        endif
        :Send job token\nto jobs channel;
    repeat while (dispatcher running?) is (yes)
    :Close jobs channel\n(signals workers to stop);
    :Wait for all workers\n(sync.WaitGroup);
    :Close results channel\n(signals collector to stop);
    :Wait for collector;
    :Return GlobalMetrics, elapsedTime;
end fork

|CLI|

:Stop liveProgress goroutine;

if (output file specified?) then (yes)
    :metrics.ToJSON(cfg, elapsed, rps);
    :Write MetricsReport to\noutput file (JSON);
else (no)
    :Format text table\n(latencies, RPS, errors,\nstatus codes);
    :Print report to stdout;
endif

stop

@enduml
