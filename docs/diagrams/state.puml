@startuml state
' ============================================================
' State Diagram — TestSession Lifecycle
' ============================================================

skinparam stateFontSize 14
skinparam stateArrowThickness 1.5
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #AAAAAA

title TestSession State Machine

[*] --> Idle : SessionManager.CreateSession()\n/ StopCh = make(chan struct{})

state Idle

note right of Idle : Session created.\nAttack not yet started.\nMetrics = nil.

Idle --> Running : session.Start()\n[config is valid]

state Running {
    state "Dispatching Jobs" as Dispatch
    state "Executing Requests\n(N workers)" as Exec
    state "Collecting Metrics" as Collect

    [*] --> Dispatch
    Dispatch --> Exec   : job enqueued
    Exec     --> Collect : RequestResult sent
    Collect  --> Dispatch : next tick
}

Running --> Completed : session.Complete(metrics, elapsed)\n[duration elapsed OR all requests done]
Running --> Stopped   : session.Stop()\n[close(stopCh) — user request or SIGINT]
Running --> Error     : session.SetError(err)\n[attack.RunAttack returns error]

state Completed {
    note right : Final metrics available.\nResults can be downloaded.
}

state Stopped {
    note right : Partial metrics available.\nTest cancelled by user.
}

state Error {
    note right : session.Error != nil.\nClient receives error message\nvia WebSocket.
}

Completed --> [*] : SessionManager.CreateSession()\n[new test replaces old]
Stopped   --> [*] : SessionManager.CreateSession()
Error     --> [*] : SessionManager.CreateSession()

note bottom of Running
    Concurrent goroutines:
    • N worker goroutines (HTTP requests)
    • 1 metrics collector goroutine
    • 1 rate-limiter / job-dispatcher goroutine
    • 1 streamMetrics goroutine (WebSocket broadcast every 50 ms)
end note

@enduml
