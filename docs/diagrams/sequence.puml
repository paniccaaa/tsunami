@startuml sequence
' ============================================================
' Диаграмма последовательности — HTTP-атака через Web API + WebSocket
' Сценарий: веб-пользователь запускает нагрузочный тест и получает метрики в реальном времени
' ============================================================

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceArrowThickness 1.5
skinparam participantFontSize 13
skinparam noteFontSize 12

actor       "Веб-пользователь" as User
participant "Handlers\n(HTTP API)"   as H
participant "SessionManager" as SM
participant "TestSession"    as TS
participant "AttackRunner\n(горутина)" as AR
participant "GlobalMetrics"  as GM
participant "Hub\n(WebSocket)" as Hub
participant "WS Client\n(браузер)" as WS

== 1. Запуск атаки ==

User -> H : POST /api/attack/start\n{ url, rate, duration, workers, ... }
activate H

H -> H : разбор и валидация StartRequest
H -> SM : CreateSession(id, attackConfig)
activate SM
SM -> TS : new TestSession(id)\nstatus = Idle
SM --> H : *TestSession
deactivate SM

H -> TS : Start()
activate TS
TS -> TS : status = Running
TS --> H
deactivate TS

H -> AR : go runAttack(session)
note right of AR : горутина — выполняет\nHTTP нагрузочный тест
H -> H  : go streamMetrics(session)
note right of H  : горутина — рассылает\nметрики каждые 50 мс

H --> User : 200 StartResponse\n{ id, status:"running" }
deactivate H

== 2. Подключение WebSocket ==

User -> Hub : WS upgrade /ws/metrics
activate Hub
Hub -> Hub : регистрация Client
Hub --> User : 101 Switching Protocols
deactivate Hub

== 3. Выполнение нагрузочного теста ==

loop [воркер-горутины — N параллельных HTTP-запросов]
    AR -> AR : HTTP-запрос → замер латентности
    AR -> GM : AddLatency / AddError / AddBytes
    activate GM
    GM -> GM : обновление счётчиков (mutex lock)
    GM --> AR
    deactivate GM
end

== 4. Трансляция метрик в реальном времени ==

loop [каждые 50 мс пока session.IsRunning()]
    H  -> GM  : buildMetricsPayload()
    activate GM
    GM --> H  : MetricsPayload
    deactivate GM

    H  -> Hub : Broadcast(WSMessage{type:"metrics", data:payload})
    activate Hub
    Hub -> WS : отправка JSON-фрейма
    activate WS
    WS --> Hub
    deactivate WS
    deactivate Hub
end

== 5. Завершение теста ==

AR -> GM : финальное чтение
activate GM
GM --> AR : GlobalMetrics
deactivate GM

AR -> TS : Complete(metrics, elapsed)
activate TS
TS -> TS : status = Completed\nElapsedTime = elapsed
TS --> AR
deactivate TS

AR -> Hub : Broadcast(WSMessage{type:"completed", data:finalPayload})
activate Hub
Hub -> WS : отправка JSON-фрейма
deactivate Hub

== Опционально: Ручная остановка ==

User -> H : POST /api/attack/stop
activate H
H -> TS : Stop()
activate TS
TS -> TS : close(stopCh)\nstatus = Stopped
TS --> H
deactivate TS
H -> Hub : Broadcast(WSMessage{type:"stopped"})
H --> User : 200 StopResponse{ id, status:"stopped" }
deactivate H

== 6. Получение итоговых результатов ==

User -> H : GET /api/attack/results
activate H
H -> TS : GetStatus() / GetMetrics()
activate TS
TS --> H : status, metrics
deactivate TS
H -> H : buildResultsResponse()
H --> User : 200 ResultsResponse\n{ summary, percentiles, statusCodes, ... }
deactivate H

@enduml
