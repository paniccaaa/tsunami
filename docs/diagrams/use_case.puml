@startuml use_case
' ============================================================
' Use Case Diagram — Tsunami HTTP Load Testing Tool
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecaseFontSize 13
skinparam arrowThickness 1.5

actor "CLI User" as CLI
actor "Web User" as Web
actor "System\n(Timer / Signal)" as Sys

rectangle "Tsunami" {

    ' ── CLI use cases ────────────────────────────────────────
    package "CLI Mode" {
        usecase "Start Web Server\n(tsunami serve)" as UC_Serve
        usecase "Run HTTP Load Test\n(tsunami attack)" as UC_AttackCLI
        usecase "View Live Progress\n(ANSI progress bar)" as UC_Progress
        usecase "Save Report to File\n(JSON output)" as UC_SaveReport
    }

    ' ── Shared configuration ─────────────────────────────────
    package "Test Configuration" {
        usecase "Configure Attack\nParameters\n(URL, rate, workers,\nduration, headers)" as UC_Config
    }

    ' ── Web / API use cases ──────────────────────────────────
    package "Web / API Mode" {
        usecase "Run HTTP Load Test\n(via REST API)" as UC_AttackWeb
        usecase "Run gRPC Load Test\n(via REST API)" as UC_AttackGRPC
        usecase "Upload .proto File" as UC_Proto
        usecase "Receive Real-Time\nMetrics (WebSocket)" as UC_WS
        usecase "Stop Test Manually\n(POST /api/attack/stop)" as UC_Stop
        usecase "View Test Status\n(GET /api/attack/status)" as UC_Status
        usecase "View Final Results\n(GET /api/attack/results)" as UC_Results
        usecase "Download Results\nas JSON" as UC_Download
    }
}

' ── CLI User associations ─────────────────────────────────
CLI --> UC_Serve
CLI --> UC_AttackCLI
CLI --> UC_Progress
CLI --> UC_SaveReport

' ── Web User associations ─────────────────────────────────
Web --> UC_AttackWeb
Web --> UC_AttackGRPC
Web --> UC_Stop
Web --> UC_Status
Web --> UC_Results
Web --> UC_Download
Web --> UC_WS

' ── System associations ───────────────────────────────────
Sys --> UC_AttackCLI : SIGINT / duration\nexpiry
Sys --> UC_AttackWeb : duration expiry

' ── include / extend relationships ───────────────────────
UC_AttackCLI ..> UC_Config     : <<include>>
UC_AttackWeb  ..> UC_Config    : <<include>>
UC_AttackGRPC ..> UC_Config    : <<include>>

UC_AttackCLI ..> UC_Progress   : <<include>>
UC_AttackWeb  ..> UC_WS        : <<include>>
UC_AttackGRPC ..> UC_WS        : <<include>>

UC_AttackCLI ..> UC_SaveReport : <<extend>>
UC_AttackGRPC ..> UC_Proto     : <<extend>>

UC_Results    ..> UC_Download  : <<extend>>

@enduml
